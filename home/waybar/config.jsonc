{
    "reload_style_on_change": true,
    "layer": "top",


    "modules-left": ["ext/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "battery"],


    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    
    "ext/workspaces": {
        "format": "{id}",
        "sort-by-number": true,
        "on-click": "activate",
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}"
    }
}
